# Copy this file to .env and fill in your values
# Never commit .env to GitHub

export DISCORD_WEBHOOK_URL="your_stocks_news_webhook_here"
export WEBHOOK_EARNINGS="your_earning_alerts_webhook_here"
export WEBHOOK_CONCALL="your_concall_intel_webhook_here"
export WEBHOOK_SMART_ALERTS="your_smart_alerts_webhook_here"
export WEBHOOK_WEEKLY_WRAP="your_weekly_wrap_webhook_here"
export GMAIL_SENDER="your_gmail@gmail.com"
export GMAIL_APP_PASSWORD="your_16_char_app_password"
export GMAIL_RECEIVER="your_gmail@gmail.com"
export GEMINI_API_KEY="your_gemini_api_key_here"

# Cloud Run only - GCS bucket used to persist state (SQLite DB, dedup
# JSON files, PDF archive) between ephemeral Job executions.
export STATE_BUCKET="your-gcs-bucket-name"
